{
  "name": "bugoslav-scannerov",
  "version": "2.0.0",
  "description": "CLI vulnerability scanner for .NET and TypeScript/JavaScript projects, powered by OSV with CISA KEV and EPSS prioritisation",
  "type": "module",
  "bin": {
    "bugoslav": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "scan": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "keywords": [
    "vulnerability",
    "security",
    "scanner",
    "osv",
    "epss",
    "cisa-kev",
    "dotnet",
    "nuget",
    "npm",
    "sca"
  ],
  "author": "Bartłomiej Komendarczuk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BElluu/BugoslavScannerov.git"
  },
  "bugs": {
    "url": "https://github.com/BElluu/BugoslavScannerov/issues"
  },
  "homepage": "https://github.com/BElluu/BugoslavScannerov#readme",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  }
}
